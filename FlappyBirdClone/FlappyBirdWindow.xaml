<Window x:Class="FlappyBirdClone.FlappyBirdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FlappyBirdClone"
        mc:Ignorable="d"
        Title="FlappyBirdWindow" Height="450" Width="800">
    <Grid>
        <Canvas Background="SkyBlue" Name="GameScreen" Height="450" Width="800" ClipToBounds="True">
            <Canvas.LayoutTransform>
                <ScaleTransform/>
            </Canvas.LayoutTransform>
            <Rectangle Name="BirdSprite"  Fill="Yellow" Width="50" Height="26" Canvas.Left="156" Canvas.Top="212">
                
            </Rectangle>

        </Canvas>
    </Grid>
</Window>
